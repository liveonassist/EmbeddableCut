{
  "name": "@embeddablecut/web",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "The EmbeddableCut editor app: FreeCut's browser editor on the Svelte UI, served as a static PWA, and the headless harness page.",
  "scripts": {
    "dev": "vp dev --host",
    "dev:quiet": "vp dev --host --mode perf",
    "dev:compare": "node scripts/run-dev-and-perf.mjs",
    "build": "vp build",
    "build:perf": "vp build --mode perf",
    "lint": "vp lint vite.config.ts",
    "lint:fix": "vp lint vite.config.ts --fix",
    "format": "vp fmt vite.config.ts package.json",
    "format:check": "vp fmt vite.config.ts package.json --check",
    "check": "vp check --no-fmt vite.config.ts",
    "preview": "vp preview",
    "preview:perf": "vp preview --host --strictPort --port 4173",
    "perf": "vp run build:perf && vp run preview:perf",
    "check:fix": "vp check vite.config.ts package.json --fix"
  },
  "dependencies": {
    "@embeddablecut/engine": "0.0.0",
    "@embeddablecut/sdk": "0.1.0",
    "@embeddablecut/ui": "0.1.0",
    "svelte": "5.57.3"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.2.2",
    "tailwindcss": "4.2.2"
  }
}
