{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:embeddablecut:schema:asset:v2",
  "title": "EmbeddableCut media asset record",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "fileName": {
      "type": "string",
      "minLength": 1
    },
    "mimeType": {
      "type": "string",
      "minLength": 1
    },
    "fileSize": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "duration": {
      "type": "number",
      "minimum": 0
    },
    "width": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "height": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "fps": {
      "type": "number",
      "minimum": 0
    },
    "codec": {
      "type": "string"
    },
    "audioCodec": {
      "type": "string"
    },
    "bitrate": {
      "type": "number",
      "minimum": 0
    },
    "contentHash": {
      "type": "string"
    },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "url"
            },
            "url": {
              "type": "string",
              "format": "uri"
            },
            "expiresAt": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "type",
            "url"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "workspace"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "file"
            },
            "fileName": {
              "type": "string",
              "minLength": 1
            },
            "lastModified": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "type",
            "fileName"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "memory"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "id",
    "fileName",
    "mimeType",
    "fileSize",
    "duration",
    "width",
    "height",
    "fps",
    "codec",
    "bitrate",
    "source"
  ],
  "additionalProperties": false
}
