{
  "name": "embeddablecut",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "engine",
    "web",
    "render"
  ],
  "scripts": {
    "check": "npm run check --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspace web",
    "check:boundaries": "node scripts/checks/overlay.mjs check-feature-boundaries.mjs",
    "check:deps-contracts": "node scripts/checks/overlay.mjs check-deps-contract-boundaries.mjs",
    "check:layer-boundaries": "node scripts/checks/overlay.mjs check-layer-boundaries.mjs",
    "check:deps-wrapper-health": "node scripts/checks/overlay.mjs check-deps-wrapper-health.mjs --fail-on-unused",
    "check:unused-exports": "node scripts/checks/overlay.mjs check-fallow-unused-exports.mjs",
    "check:unused-class-members": "node scripts/checks/overlay.mjs check-fallow-unused-class-members.mjs",
    "check:edge-budgets": "node scripts/checks/overlay.mjs check-feature-edge-budgets.mjs",
    "report:feature-edges": "node scripts/checks/overlay.mjs report-feature-edges.mjs",
    "check:architecture": "npm run check:boundaries && npm run check:deps-contracts && npm run check:layer-boundaries && npm run check:deps-wrapper-health && npm run check:unused-exports && npm run check:unused-class-members && npm run check:edge-budgets"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@types/node": "22.19.17",
    "@vitest/coverage-v8": "5.0.3",
    "@webgpu/types": "0.1.69",
    "istanbul-lib-coverage": "3.2.2",
    "jsdom": "27.4.0",
    "typescript": "7.0.2",
    "v8-to-istanbul": "9.3.0",
    "vite-plus": "1.1.0",
    "vitest": "5.0.3"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
    "vitest": "5.0.3"
  },
  "packageManager": "npm@11.8.0"
}
