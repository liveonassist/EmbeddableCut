{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "types": ["vite-plus/test/globals", "@webgpu/types", "svelte"],

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,

    /*
     * `@/` is layered as in the React app: the UI's own sources first, then the
     * engine's, which mirror FreeCut's src/. `$lib` and `$components` are the
     * UI's shared code.
     */
    "paths": {
      "@/*": ["./src/*", "../engine/src/*"],
      "$lib/*": ["./src/lib/*"],
      "$components/*": ["./src/components/*"]
    }
  },
  "include": ["src", "../engine/src/**/*.d.ts"]
}
