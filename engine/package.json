{
  "name": "@embeddablecut/engine",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "EmbeddableCut's framework-independent editing engine: timeline, media, effects, playback and rendering.",
  "exports": {
    "./*": "./src/*"
  },
  "scripts": {
    "check": "vp check --no-fmt src vite.config.ts",
    "lint": "vp lint src vite.config.ts",
    "format": "vp fmt src vite.config.ts",
    "format:check": "vp fmt src vite.config.ts --check",
    "test": "vp test run",
    "test:coverage": "vp test run --coverage"
  },
  "dependencies": {
    "@huggingface/transformers": "4.1.0",
    "@lottiefiles/dotlottie-web": "0.76.0",
    "@mediabunny/aac-encoder": "1.54.0",
    "@mediabunny/ac3": "1.54.0",
    "@mediabunny/mp3-encoder": "1.54.0",
    "@mediabunny/prores": "1.54.0",
    "clsx": "2.1.1",
    "fflate": "0.8.2",
    "gifuct-js": "2.1.2",
    "i18next": "25.6.0",
    "i18next-browser-languagedetector": "8.2.0",
    "idb": "8.0.3",
    "kokoro-js": "1.2.1",
    "mediabunny": "1.54.0",
    "onnxruntime-web": "1.26.0-dev.20260410-5e55544225",
    "tailwind-merge": "2.6.1",
    "zod": "4.3.6",
    "zustand": "5.0.12"
  }
}
